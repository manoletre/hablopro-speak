rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Match the bookmarks collection
    match /bookmarks/{bookmarkId} {
      // Allow read, update, delete only if user is authenticated and the bookmark belongs to them
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow creation only if user is authenticated and they're setting their own userId
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid && 
                     request.resource.data.type in ['grammar', 'vocabulary'] &&
                     request.resource.data.content is map;
    }
    
    // Allow authenticated users to manage their sessions and view streak data
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      match /sessions/{sessionId} {
        // Allow creation only with server timestamp
        allow create: if request.auth != null && 
                       request.auth.uid == uid && 
                       request.resource.data.startedAt == request.time;
        allow read: if request.auth != null && request.auth.uid == uid;
        // Allow updates to add transcript and finishedAt when session ends
        allow update: if request.auth != null && 
                       request.auth.uid == uid &&
                       resource.data.startedAt != null; // Session must exist
        allow delete: if false; // Never allow session deletion
        
        // Vocabulary subcollection
        match /vocabulary/{vocabId} {
          allow create: if request.auth != null && 
                         request.auth.uid == uid &&
                         request.resource.data.createdAt != null;
          allow read: if request.auth != null && request.auth.uid == uid;
          allow update, delete: if false; // Make vocabulary items immutable
        }
        
        // Grammar subcollection
        match /grammar/{grammarId} {
          allow create: if request.auth != null && 
                         request.auth.uid == uid &&
                         request.resource.data.createdAt != null;
          allow read: if request.auth != null && request.auth.uid == uid;
          allow update, delete: if false; // Make grammar items immutable
        }
      }
      
      match /questions/{questionId} {
        // Allow creation and reading of questions by the authenticated user
        allow create: if request.auth != null && 
                       request.auth.uid == uid &&
                       request.resource.data.createdAt != null;
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false; // Make questions immutable
      }
      
      match /days/{dayId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Days collection should only be written by Cloud Functions
      }
      
      // Billing collection - allow server-side operations only
      match /billing/{billingDoc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Billing should only be modified by server-side code, but we need to allow it for now
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      
      // Usage collection - allow server-side operations to track usage
      match /usage/{usageId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Usage should only be created by server-side code, but we need to allow it for now
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false; // Usage records should be immutable
      }
      
      // Purchases collection - allow server-side operations to track purchases
      match /purchases/{purchaseId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Purchases should only be created by server-side code, but we need to allow it for now
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false; // Purchase records should be immutable
      }
    }
    
    // Webhook events collection - server-side only for deduplication
    match /webhook_events/{eventId} {
      // Only allow server-side operations (webhook processing)
      allow read, write: if false; // Block all client access
    }
    
    // Health check collection - server-side only
    match /health_check/{checkId} {
      // Only allow server-side operations
      allow read, write: if false; // Block all client access
    }
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}