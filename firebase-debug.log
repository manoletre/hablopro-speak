[debug] [2025-06-01T17:13:31.334Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/hablopro-speak:securityRules [none]
[debug] [2025-06-01T17:13:31.335Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/hablopro-speak:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Match the bookmarks collection\n    match /bookmarks/{bookmarkId} {\n      // Allow read, update, delete only if user is authenticated and the bookmark belongs to them\n      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;\n      \n      // Allow creation only if user is authenticated and they're setting their own userId\n      allow create: if request.auth != null && \n                     request.resource.data.userId == request.auth.uid && \n                     request.resource.data.type in ['grammar', 'vocabulary'] &&\n                     request.resource.data.content is map;\n    }\n    \n    // Allow authenticated users to manage their sessions and view streak data\n    match /users/{uid} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n      \n      match /sessions/{sessionId} {\n        // Allow creation only with server timestamp\n        allow create: if request.auth != null && \n                       request.auth.uid == uid && \n                       request.resource.data.startedAt == request.time;\n        allow read: if request.auth != null && request.auth.uid == uid;\n        // Allow updates to add transcript and finishedAt when session ends\n        allow update: if request.auth != null && \n                       request.auth.uid == uid &&\n                       resource.data.startedAt != null; // Session must exist\n        allow delete: if false; // Never allow session deletion\n        \n        // Vocabulary subcollection\n        match /vocabulary/{vocabId} {\n          allow create: if request.auth != null && \n                         request.auth.uid == uid &&\n                         request.resource.data.createdAt != null;\n          allow read: if request.auth != null && request.auth.uid == uid;\n          allow update, delete: if false; // Make vocabulary items immutable\n        }\n        \n        // Grammar subcollection\n        match /grammar/{grammarId} {\n          allow create: if request.auth != null && \n                         request.auth.uid == uid &&\n                         request.resource.data.createdAt != null;\n          allow read: if request.auth != null && request.auth.uid == uid;\n          allow update, delete: if false; // Make grammar items immutable\n        }\n      }\n      \n      match /questions/{questionId} {\n        // Allow creation and reading of questions by the authenticated user\n        allow create: if request.auth != null && \n                       request.auth.uid == uid &&\n                       request.resource.data.createdAt != null;\n        allow read: if request.auth != null && request.auth.uid == uid;\n        allow update, delete: if false; // Make questions immutable\n      }\n      \n      match /days/{dayId} {\n        allow read: if request.auth != null && request.auth.uid == uid;\n        // Days collection should only be written by Cloud Functions\n      }\n    }\n    \n    // Deny access to all other collections by default\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}"}]}}
